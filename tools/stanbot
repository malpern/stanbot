#!/usr/bin/env python3
"""What Stanbot is doing, from a shell.

    tools/stanbot status          # a short report
    tools/stanbot status --json   # the whole object
    tools/stanbot watch           # the short report, until interrupted

    tools/stanbot sleep           # and: wake, reboot, follow, unfollow
    tools/stanbot mouth grille    # capsule | grille
    tools/stanbot expression sad
    tools/stanbot screenshot /tmp/face.jpg   # what is on the robot's screen

Commands go THROUGH the app, which holds the robot's transport, rather than
opening the robot's USB port alongside it -- two readers on one port do not
share, and every symptom of that fight looks like a broken robot. They print
what happened and exit non-zero if it did not.

The app is the only thing that can talk to the robot -- it holds the robot's one
Wi-Fi viewer slot -- so its own state is the answer to most questions, and until
this existed the only way to read it was to look at the window. The app writes
`~/Library/Logs/Stanbot/status.json` about once a second; this reads it.

It reports the file's age, because a stale file and a live one look identical
otherwise, and "Follow is on" from a status written an hour ago is a wrong
answer rather than a missing one. Stdlib only.
"""
import argparse
import json
import os
import sys
import time

STATUS = os.path.expanduser("~/Library/Logs/Stanbot/status.json")
STALE_SECONDS = 5


def read(path=STATUS):
    """The status object and how many seconds old it is, or (None, reason)."""
    if not os.path.exists(path):
        return None, "no status file: is Stanbot running? (%s)" % path
    try:
        with open(path) as f:
            status = json.load(f)
    except (ValueError, OSError) as error:
        return None, "unreadable status file: %s" % error
    return status, time.time() - os.path.getmtime(path)


def describe(status, age):
    """The short report: what it is doing, and why it is not doing the rest."""
    lines = []
    if age > STALE_SECONDS:
        lines.append("STALE: written %.0f s ago -- Stanbot is not running, or is wedged." % age)
    lines.append("connection  %s" % status.get("connection", "?"))
    firmware = status.get("firmware") or {}
    if firmware:
        bits = ["yaw +-%s" % firmware["yaw_range"] if "yaw_range" in firmware else None,
                "pitch" if firmware.get("pitch") else "yaw only",
                "owes a look around" if firmware.get("scan_pending") else None,
                "DIRTY BUILD" if firmware.get("dirty") else None]
        lines.append("firmware    %s (%s)" % (firmware.get("commit", "?"),
                                              ", ".join(b for b in bits if b)))
    follow = status.get("follow") or {}
    state = follow.get("state", "?")
    detail = ""
    if state == "finished" and follow.get("last_result"):
        detail = " -- last: %s" % follow["last_result"]
    lines.append("follow      toggle %s, %s%s" % ("ON" if follow.get("toggle") else "OFF", state, detail))
    if follow.get("unavailable_reason"):
        lines.append("            cannot start: %s" % follow["unavailable_reason"])
    lines.append("camera      %s, face %s" % (status.get("camera", "?"), status.get("face", "?")))
    if status.get("asleep"):
        lines.append("            asleep")
    place = status.get("last_seen")
    lines.append("last seen   %s" % ("yaw %s, pitch %s" % (place["yaw"], place["pitch"]) if place
                                     else "nowhere yet (nothing remembered)"))
    if status.get("last_action"):
        lines.append("last action %s" % status["last_action"])
    return "\n".join(lines)


COMMANDS = ["sleep", "wake", "reboot", "follow", "unfollow", "mouth", "expression", "screenshot"]
COMMAND = os.path.expanduser("~/Library/Logs/Stanbot/command.json")
RESULT = os.path.expanduser("~/Library/Logs/Stanbot/command-result.json")


def command(verb, argument=None, timeout=12.0, request_path=COMMAND, result_path=RESULT):
    """Ask the app to do something; return (ok, detail).

    Through the app rather than the robot's USB port on purpose: the app holds
    that port, and a second process opening it fights for every reply. See
    CommandFile.swift.
    """
    request = {"id": "%d-%d" % (int(time.time() * 1000), os.getpid()), "command": verb}
    if argument:
        request["argument"] = argument
    temporary = request_path + ".%d.tmp" % os.getpid()
    os.makedirs(os.path.dirname(request_path), exist_ok=True)
    with open(temporary, "w") as f:
        json.dump(request, f)
    os.replace(temporary, request_path)   # atomic: the app never sees half of it

    # Wait for a result carrying OUR id. Anything else is a previous answer,
    # and reporting one of those as this command's outcome is the stale-answer
    # trap that had screenshot.py handing back an old picture.
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            with open(result_path) as f:
                answer = json.load(f)
            if answer.get("id") == request["id"]:
                return bool(answer.get("ok")), answer.get("detail", "")
        except (OSError, ValueError):
            pass
        time.sleep(0.2)
    return False, ("the app did not answer in %.0f s. Is Stanbot running? "
                   "(`tools/stanbot status` says)" % timeout)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("verb", nargs="?", default="status",
                        choices=["status", "watch"] + COMMANDS)
    parser.add_argument("argument", nargs="?", help="for mouth (capsule|grille) and expression")
    parser.add_argument("--json", action="store_true", help="print the whole status object")
    parser.add_argument("--path", default=STATUS, help="a status file elsewhere")
    args = parser.parse_args(argv)

    if args.verb in COMMANDS:
        argument = args.argument
        if args.verb == "screenshot":
            # The app resolves a relative path against ITS working directory,
            # not this shell's, so the picture would land somewhere surprising.
            argument = os.path.abspath(argument or "stanbot-screen.jpg")
        ok, detail = command(args.verb, argument)
        print(detail, file=sys.stdout if ok else sys.stderr)
        return 0 if ok else 1

    while True:
        status, age = read(args.path)
        if status is None:
            print(age, file=sys.stderr)
            return 1
        print(json.dumps(status, indent=2, sort_keys=True) if args.json else describe(status, age))
        if args.verb != "watch":
            return 0 if age <= STALE_SECONDS else 2
        time.sleep(1)
        print()


if __name__ == "__main__":
    sys.exit(main())
